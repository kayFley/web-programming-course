{
  "name": "quiz-backend",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "tsc --noEmit",
    "db:migrate": "bunx prisma migrate dev",
    "db:generate": "bunx prisma generate",
    "db:studio": "bunx prisma studio",
    "db:reset": "bunx prisma migrate reset",
    "test:unit": "vitest run \"src/**/*.unit.test.ts\"",
    "test:feature": "vitest run \"src/**/*.feature.test.ts\"",
    "test": "vitest run src",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docker:build": "podman build --format docker -t quiz-backend:local .",
    "docker:run": "podman run --rm -p 3000:3000 --env-file .env.container quiz-backend:local",
    "compose:up": "podman compose up --build -d",
    "compose:down": "podman compose down -v",
    "compose:logs": "podman compose logs -f backend",
    "ci:local": "bash ./scripts/local-release.sh",
    "ci:local:win": "powershell -ExecutionPolicy Bypass -File .\\scripts\\local-release.ps1"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@libsql/client": "^0.17.0",
    "@prisma/adapter-libsql": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "dotenv": "^17.3.1",
    "hono": "^4.12.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "@vitest/coverage-v8": "^4.1.2",
    "bun-types": "^1.3.11",
    "prettier": "^3.8.1",
    "prisma": "^7.4.1",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2",
    "vitest-mock-extended": "^3.1.0"
  }
}
